---
const baseUrl = import.meta.env.BASE_URL;
const navItems = [
  { href: baseUrl, label: 'Home' },
  { href: `${baseUrl}about/`, label: 'About' },
  { href: `${baseUrl}meetings/`, label: 'Meetings' },
  { href: `${baseUrl}gallery/`, label: 'Gallery' },
  { href: `${baseUrl}contact/`, label: 'Contact' }
];

const currentPath = Astro.url.pathname;
const homePath = baseUrl;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={baseUrl} aria-label="F-Stop Camera Club home">
      <span class="brand-mark" aria-hidden="true">F</span>
      <span class="brand-text">F-Stop Camera Club</span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="nav-list">
        {
          navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== homePath && currentPath.startsWith(item.href));

            return (
              <li>
                <a href={item.href} aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
