---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Contact | F-Stop Camera Club';
const pageDescription =
  'Contact F-Stop Camera Club to visit a monthly meeting in Chatteris, Cambridgeshire.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="section">
    <div class="container prose">
      <h1>Contact</h1>
      <p>
        Interested in visiting F-Stop Camera Club? New faces are always welcome at our monthly meetings.
      </p>
      <h2>Get in Touch</h2>
      <p>
        Email: hello@fstopcameraclub.org<br />
        Phone: 01234 567890
      </p>
      <p>
        Meeting venue: Chatteris Community Hall, Cambridgeshire
      </p>
      <p>
        <!-- TODO: Replace placeholder contact details with real club email and preferred contact method. -->
      </p>
      <h2>Find Us on Facebook</h2>
      <p>We have two Facebook groups — one for everyone, one for members.</p>
      <ul>
        <li>
          <a class="text-link" href="https://www.facebook.com/groups/135539084457507" target="_blank" rel="noopener noreferrer">Community group</a>
          — open to anyone in the local area. A good place to follow club news and ask questions
          before your first visit. Request to join and we'll accept you.
        </li>
        <li>
          <a class="text-link" href="https://www.facebook.com/groups/718663239671283" target="_blank" rel="noopener noreferrer">Members-only group</a>
          — private group for fee-paying members. Once you join the club (annual fee: £30),
          a committee member will add you.
        </li>
      </ul>
      <h2>Before Your First Visit</h2>
      <ul>
        <li>Bring a camera or smartphone if you wish</li>
        <li>No formal experience is required</li>
        <li>You are welcome to come along and see how the evening runs</li>
      </ul>
    </div>
  </section>
</BaseLayout>
