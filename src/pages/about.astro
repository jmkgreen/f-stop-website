---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'About | F-Stop Camera Club';
const pageDescription =
  'Learn about F-Stop Camera Club, a friendly monthly photography group in Chatteris, Cambridgeshire.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="section">
    <div class="container prose">
      <h1>About the Club</h1>
      <p>
        F-Stop Camera Club is a local community group for people who enjoy photography,
        from complete beginners to experienced hobbyists.
      </p>
      <p>
        We meet monthly in Chatteris, Cambridgeshire to share images, learn practical
        techniques, and support one another in developing creative confidence.
      </p>
      <h2>What We Do</h2>
      <ul>
        <li>Monthly themed meetings</li>
        <li>Image sharing and constructive feedback</li>
        <li>Occasional local photo walks</li>
        <li>Support with camera and editing basics</li>
      </ul>
      <h2>Membership</h2>
      <p>
        Annual membership costs <strong>£30</strong>. Becoming a member gives you full access to club
        activities and adds you to our private members-only Facebook group, where members share
        work, discuss ideas, and stay connected between meetings.
      </p>
      <p>
        Not ready to commit? Our
        <a class="text-link" href="https://www.facebook.com/groups/135539084457507" target="_blank" rel="noopener noreferrer">community Facebook group</a>
        is open to anyone in the local area — a relaxed place to follow what we get up to and ask
        questions before your first visit.
      </p>
      <p>
        <!-- TODO: Add a short paragraph on club history and how meetings are organised if relevant. -->
      </p>
    </div>
  </section>
</BaseLayout>
