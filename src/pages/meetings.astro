---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Meetings | F-Stop Camera Club';
const pageDescription =
  'Find meeting dates, times, themes, and venue details for F-Stop Camera Club in Chatteris.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="section">
    <div class="container prose">
      <h1>Meetings</h1>
      <p>
        We meet once a month in Chatteris and welcome new visitors.
      </p>
      <h2>Regular Schedule</h2>
      <p>
        We physically meet on the final Wednesday of each month, 7:00 PM to 9:00 PM.<br />
        Our venue is usually the Chatteris Museum (<em>CM</em>) (<a href="https://maps.app.goo.gl/GbaPNXWihwctoQw56">map</a>), Cambridgeshire.
      </p>
      <p>
        Additionally we hold a photo competition each month. Members should submit 2x shots taken during the competition time for voting during our meeting.
      </p>
      <h2>2026 Sessions</h2>
      <table>
      <thead>
        <tr>
          <th>Month</th>
          <th>Meeting</th>
          <th>Competition</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>January</td>
          <td>Photo editing - please bring a laptop or tablet to try things out.</td>
          <td>Juxtaposition</td>
        </tr>
        <tr>
          <td>February</td>
          <td>Food photography talk</td>
          <td>Pantone colour of the year</td>
        </tr>
        <tr>
          <td>March</td>
          <td>Macro talk (Bob Brind-Surch)</td>
          <td>Signs of spring</td>
        </tr>
        <tr>
          <td>April</td>
          <td>Macro photography evening.</td>
          <td>Footpath finds</td>
        </tr>
        <tr>
          <td>May</td>
          <td>Birds of prey photoshoot</td>
          <td>Alternative angles</td>
        </tr>
        <tr>
          <td>June</td>
          <td>Depth of field/ Intentional Camera Movement (ICM) at Pocket Park</td>
          <td>Insects</td>
        </tr>
        <tr>
          <td>July</td>
          <td>Ely photo walk – meeting point TBC</td>
          <td>Golden hour</td>
        </tr>
        <tr>
          <td>August</td>
          <td>Summer BBQ (CM)</td>
          <td>Harvest</td>
        </tr>
        <tr>
          <td>September</td>
          <td>Club AGM</td>
          <td>Light and shadow</td>
        </tr>
        <tr>
          <td>October</td>
          <td>Portrait (Pirate steam punk)</td>
          <td>Spooky</td>
        </tr>
        <tr>
          <td>November</td>
          <td>Fire photography – Location TBC</td>
          <td>Solitude</td>
        </tr>
        <tr>
          <td>December</td>
          <td>Christmas meal - Location TBC</td>
          <td>Joy</td>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3">Due to the nature of our sessions they are subject to change without notice. We will endeavour to replace subjects to ensure sessions remain 'on'. Follow our FaceBook group for the latest updates. Members can also be joined to a WhatsApp group for updates.</td>
        </tr>
      </tfoot>
      </table>

    </div>
  </section>
</BaseLayout>
