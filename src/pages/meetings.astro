---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Meetings | F-Stop Camera Club';
const pageDescription =
  'Find meeting dates, times, themes, and venue details for F-Stop Camera Club in Chatteris.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="section">
    <div class="container prose">
      <h1>Meetings</h1>
      <p>
        We meet once a month in Chatteris and welcome new visitors.
      </p>
      <h2>Regular Schedule</h2>
      <p>
        Third Thursday of each month, 7:30 PM to 9:30 PM.<br />
        Chatteris Community Hall, Cambridgeshire.
      </p>
      <h2>Upcoming Sessions</h2>
      <ul>
        <li>18 April 2026: Street details and texture</li>
        <li>16 May 2026: Portrait lighting at home</li>
        <li>20 June 2026: Summer evening photo walk</li>
      </ul>
      <p>
        <!-- TODO: Keep this list updated or replace with final annual programme text. -->
      </p>
    </div>
  </section>
</BaseLayout>
